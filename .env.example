# Copy to .env and fill in. Never commit .env.
FLASK_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection (Liara: copy the connection string from the database panel)
DATABASE_URL=postgresql://career:change-me@localhost:5432/career

# Multi-application: give every app that shares the same database its own schema
DB_SCHEMA=career

# Persistent volume for uploaded files (Liara disk / docker volume mount point)
UPLOAD_PATH=/usr/src/app/uploads

# Cookies are HTTPS-only in production; set to false only for plain-HTTP testing
SESSION_COOKIE_SECURE=true

# Optional: shared rate-limit storage when running several instances (needs `redis` package)
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Optional: number of reverse proxies in front of the app (default 1)
# PROXY_FIX_COUNT=1

# Used by docker-compose only
POSTGRES_USER=career
POSTGRES_PASSWORD=change-me
POSTGRES_DB=career
